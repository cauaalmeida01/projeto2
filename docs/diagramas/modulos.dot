// Diagrama de módulos do Veridit (pacotes UML)
// Gerar: dot -Tsvg modulos.dot -o modulos.svg
digraph modulos {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.25, ranksep=0.7, compound=true, newrank=true, pad=0.3,
         label=<<b>Veridit — Diagrama de módulos (pacotes UML)</b><br/><font point-size="10">Um pacote por unidade implantável (ADR-003). Setas tracejadas: dependência «use». Cada serviço só depende de outro pela API dele (pacote api).</font>>, labelloc=t];
  node  [fontname="DejaVu Sans", fontsize=9.5, shape=tab, style=filled, fillcolor="#FFFFFF", color="#102A43"];
  edge  [fontname="DejaVu Sans", fontsize=8, style=dashed, arrowhead=vee, color="#4A5A6A", fontcolor="#34495E", label="«use»"];

  subgraph cluster_veridit {
    label="«system» veridit"; style="rounded"; color="#102A43"; fontsize=11;

    subgraph cluster_web {
      label="web"; style="filled"; fillcolor="#EEF3F8"; color="#102A43";
      web_paginas [label="paginas"]; web_visual [label="visualizador_captura"]; web_cliente [label="cliente_api"];
    }
    subgraph cluster_gateway {
      label="gateway"; style="filled"; fillcolor="#EEF3F8"; color="#102A43";
      gw_token [label="validacao_token"]; gw_rotas [label="roteamento"]; gw_limites [label="limite_requisicoes"];
    }
    subgraph cluster_contas {
      label="contas  (REQ 01–04)"; style="filled"; fillcolor="#EEF3F8"; color="#102A43";
      ct_api [label="api"]; ct_usuarios [label="usuarios\n(advogado, usuario_comum)"]; ct_aut [label="autenticacao", color="#C0392B", penwidth=2];
      ct_rec [label="recuperacao_senha"]; ct_pers [label="persistencia"];
    }
    subgraph cluster_creditos {
      label="creditos  (REQ 05–07)"; style="filled"; fillcolor="#EEF3F8"; color="#102A43";
      cr_api [label="api"]; cr_catalogo [label="catalogo_pacotes"]; cr_carteira [label="carteira"];
      subgraph cluster_pag {
        label="pagamentos"; style="filled"; fillcolor="#FFFFFF"; color="#102A43";
        cr_prov [label="provedor_pagamento\n(interface)"]; cr_mp [label="adaptador_mercado_pago"]; cr_pix [label="adaptador_pix"]; cr_webhook [label="notificacoes_provedor"];
      }
      cr_pers [label="persistencia"]; cr_saida [label="caixa_saida"];
    }
    subgraph cluster_captura {
      label="captura  (REQ 08, 09, 11)"; style="filled"; fillcolor="#FDECEC"; color="#C0392B"; penwidth=2;
      cp_api [label="api"];
      cp_orq [label="orquestracao\n(maquina_estados, supervisor)", color="#C0392B", penwidth=2];
      cp_nav [label="navegacao\n(pool, transmissao, gravacao)", color="#C0392B", penwidth=2];
      cp_sel [label="selagem\n(hash, manifesto, assinatura)", color="#C0392B", penwidth=2];
      cp_saida [label="caixa_saida"]; cp_pers [label="persistencia"];
    }
    subgraph cluster_registros {
      label="registros  (REQ 12–15)"; style="filled"; fillcolor="#EEF3F8"; color="#102A43";
      rg_api [label="api"]; rg_ev [label="evidencias\n(repositorio, verificador)", color="#C0392B", penwidth=2];
      rg_cons [label="consulta"]; rg_rel [label="relatorio"]; rg_zip [label="pacote_zip"]; rg_pers [label="persistencia"];
    }
    subgraph cluster_notif {
      label="notificacoes  (REQ 07, 10, 11 dup.)"; style="filled"; fillcolor="#EEF3F8"; color="#102A43";
      nt_api [label="api"]; nt_envio [label="envio_email"]; nt_modelos [label="modelos_email"];
    }
    subgraph cluster_comum {
      label="compartilhado (bibliotecas usadas por gateway e todos os serviços)"; style="filled"; fillcolor="#F4F6F8"; color="#5D6D7E";
      cm_contratos [label="contratos_api"]; cm_seg [label="seguranca\n(verificacao_posse)"]; cm_saida [label="despachante_caixa_saida"]; cm_obs [label="observabilidade"];
    }
  }

  // Dependências principais
  web_cliente -> gw_rotas [lhead=cluster_gateway];
  gw_rotas -> ct_api; gw_rotas -> cr_api; gw_rotas -> cp_api; gw_rotas -> rg_api;
  gw_token -> ct_api [label="«use» chaves públicas"];

  ct_api -> ct_aut; ct_aut -> ct_usuarios; ct_rec -> ct_aut; ct_aut -> ct_pers;
  cr_api -> cr_carteira; cr_api -> cr_prov; cr_mp -> cr_prov [arrowhead=onormal, style=dashed, label="«realize»"]; cr_pix -> cr_prov [arrowhead=onormal, style=dashed, label="«realize»"];
  cr_webhook -> cr_carteira; cr_carteira -> cr_catalogo; cr_carteira -> cr_pers;
  cp_api -> cp_orq; cp_orq -> cp_nav; cp_nav -> cp_sel; cp_orq -> cp_sel; cp_orq -> cp_saida; cp_orq -> cp_pers;
  rg_api -> rg_cons; rg_api -> rg_rel; rg_api -> rg_zip; rg_cons -> rg_ev; rg_rel -> rg_ev; rg_zip -> rg_ev; rg_ev -> rg_pers;
  nt_api -> nt_envio -> nt_modelos;

  // Dependências entre serviços (sempre pela api)
  edge [color="#C0392B", fontcolor="#922B21"];
  cp_orq -> cr_api [label="«use» reserva de crédito"];
  cp_sel -> rg_api [label="«use» armazenar evidência"];
  cp_saida -> nt_api [label="«use» e-mails"];
  cr_saida -> nt_api; ct_rec -> nt_api;

  // Biblioteca comum
  // compartilhado fica na base: usado por todos os serviços e pelo gateway
  {rank=same; cm_contratos; cm_seg; cm_saida; cm_obs; rg_pers;}

  {rank=same; ct_api; cr_api; cp_api; rg_api; nt_api;}
}
