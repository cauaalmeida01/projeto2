// Diagrama de componentes do Veridit (visão geral)
// Gerar: dot -Tsvg componentes.dot -o componentes.svg && dot -Tpng -Gdpi=150 componentes.dot -o componentes.png
digraph componentes {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, nodesep=0.35, ranksep=0.6, newrank=true,
         label=<<b>Veridit — Diagrama de componentes (arquitetura baseada em serviços, ADR-003)</b><br/><font point-size="10">Em vermelho: componentes críticos (5 de 14 = 35,7%), especificados em componentes-criticos.svg</font>>,
         labelloc=t, pad=0.3];
  node  [fontname="DejaVu Sans", fontsize=10, shape=component, style=filled, fillcolor="#EEF3F8", color="#102A43", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=8, color="#4A5A6A", fontcolor="#34495E", arrowsize=0.7];

  usuario [label="Usuário\n(advogado ou usuário comum, D1)", shape=none, fillcolor=white, image="", fontsize=10];

  c01 [label="«component»\nC01 Aplicação Web"];
  c02 [label="«component»\nC02 API Gateway"];

  subgraph cluster_contas {
    label="«service» Contas e Acesso\nREQ 01–04"; style="rounded,dashed"; color="#102A43"; fontsize=10;
    c03 [label="«component»\nC03 Gestão de Usuários"];
    c04 [label="«component»\nC04 Autenticação e Sessão", fillcolor="#FDECEC", color="#C0392B", penwidth=2.2];
  }
  subgraph cluster_creditos {
    label="«service» Créditos e Pagamentos\nREQ 05–07"; style="rounded,dashed"; color="#102A43"; fontsize=10;
    c05 [label="«component»\nC05 Catálogo e\nCarteira de Créditos"];
    c06 [label="«component»\nC06 Pagamentos"];
  }
  subgraph cluster_captura {
    label="«service» Captura\nREQ 08, 09, 11"; style="rounded,dashed"; color="#C0392B"; fontsize=10;
    c07 [label="«component»\nC07 Orquestrador\nde Captura", fillcolor="#FDECEC", color="#C0392B", penwidth=2.2];
    c08 [label="«component»\nC08 Ambiente de\nNavegação Controlada", fillcolor="#FDECEC", color="#C0392B", penwidth=2.2];
    c09 [label="«component»\nC09 Selagem\nde Evidências", fillcolor="#FDECEC", color="#C0392B", penwidth=2.2];
  }
  subgraph cluster_registros {
    label="«service» Registros e Evidências\nREQ 12–15"; style="rounded,dashed"; color="#102A43"; fontsize=10;
    c10 [label="«component»\nC10 Repositório\nde Evidências", fillcolor="#FDECEC", color="#C0392B", penwidth=2.2];
    c11 [label="«component»\nC11 Consulta\nde Registros"];
    c12 [label="«component»\nC12 Gerador\nde Relatório"];
    c13 [label="«component»\nC13 Gerador de\nPacote Zip"];
  }
  subgraph cluster_notif {
    label="«service» Notificações\nREQ 07, 10, 11 dup."; style="rounded,dashed"; color="#102A43"; fontsize=10;
    c14 [label="«component»\nC14 Notificações\npor E-mail"];
  }

  // Infraestrutura
  db    [label="Banco relacional compartilhado\nesquemas: contas | creditos | captura\nregistros | notificacoes (ADR-004)\nusado por todos os serviços,\ncada um no próprio esquema", shape=cylinder, fillcolor="#F4F6F8", color="#5D6D7E"];
  obj   [label="Armazenamento de objetos\ncom bloqueio de escrita\n(ADR-004)", shape=cylinder, fillcolor="#F4F6F8", color="#5D6D7E"];
  cofre [label="Cofre de chaves\n(ADR-005)", shape=cylinder, fillcolor="#F4F6F8", color="#5D6D7E"];

  // Sistemas externos
  node [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#7F8C8D", fontcolor="#2C3E50"];
  mp    [label="«external»\nMercado Pago"];
  pix   [label="«external»\nProvedor Pix"];
  email [label="«external»\nProvedor de e-mail"];
  sites [label="«external»\nSites da internet"];
  tsa   [label="«external»\nAutoridade de\nCarimbo do Tempo"];

  usuario -> c01;
  c01 -> c02 [label="HTTPS / REST"];
  c01 -> c08 [label="tela do navegador remoto\n(via C02)", style=dashed, constraint=false];
  c02 -> c03 [label="IUsuarios"];
  c02 -> c04 [label="ISessoes"];
  c02 -> c05 [label="IPacotes"];
  c02 -> c06 [label="ICompras"];
  c02 -> c07 [label="IRegistrosCaptura"];
  c02 -> c11 [label="IConsulta"];
  c02 -> c12 [label="IRelatorio"];
  c02 -> c13 [label="IPacoteZip"];

  c04 -> c03;
  c06 -> c05 [label="creditar"];
  c07 -> c05 [label="reservar / confirmar /\nestornar crédito"];
  c07 -> c08 [label="alocar / comandar / liberar"];
  c08 -> c09 [label="selarArquivo"];
  c07 -> c09 [label="fecharManifesto"];
  c09 -> c10 [label="armazenar (somente inclusão)"];
  c11 -> c10; c12 -> c10; c13 -> c10;
  c04 -> c14 [label="e-mail de\nrecuperação", style=dashed];
  c06 -> c14 [label="pedido de e-mail\n(caixa de saída)", style=dashed];
  c07 -> c14 [label="pedido de e-mail\n(caixa de saída)", style=dashed];

  c06 -> mp; c06 -> pix;
  mp -> c06 [label="notificação\nde pagamento", style=dashed];
  pix -> c06 [style=dashed];
  c14 -> email;
  c08 -> sites [label="navega"];
  c09 -> tsa [label="carimbo"];
  c09 -> cofre [label="assinar"];
  c10 -> obj;

  {rank=same; db; obj; cofre;}
  {rank=same; c03; c05; c11; c07; c14;}
  {rank=same; mp; pix; email; sites; tsa;}
}
