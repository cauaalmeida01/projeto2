// Especificação interna dos componentes críticos (C04, C07, C08, C09, C10)
// Gerar: dot -Tsvg componentes-criticos.dot -o componentes-criticos.svg
digraph criticos {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, nodesep=0.25, ranksep=0.55, compound=true, pad=0.3,
         label=<<b>Veridit — Especificação interna dos componentes críticos</b><br/><font point-size="10">C04, C07, C08, C09 e C10 (5 de 14 componentes = 35,7%). Círculos: interfaces oferecidas. Detalhes em docs/componentes.md, seção 5.</font>>, labelloc=t];
  node  [fontname="DejaVu Sans", fontsize=9.5, shape=component, style=filled, fillcolor="#FFFFFF", color="#102A43"];
  edge  [fontname="DejaVu Sans", fontsize=8, color="#4A5A6A", fontcolor="#34495E", arrowsize=0.6];

  // Interfaces (lollipop)
  node [shape=circle, fontsize=8.5, fontcolor="#102A43", width=0.13, height=0.13, fixedsize=true, label="", fillcolor="#FFFFFF", color="#102A43"];
  graph [forcelabels=true];
  i_sess   [xlabel="ISessoes"];
  i_chaves [xlabel="IChavesPublicas"];
  i_reg    [xlabel="IRegistrosCaptura"];
  i_status [xlabel="IStatusRegistro"];
  i_nav    [xlabel="INavegacao"];
  i_selar  [xlabel="ISelagem"];
  i_arm    [xlabel="IArmazenamento"];
  i_ler    [xlabel="ILeituraEvidencias"];
  node [shape=component, style=filled, fillcolor="#FFFFFF", color="#102A43", fontsize=9.5, fixedsize=false, width=0.75, height=0.5];

  subgraph cluster_c04 {
    label="«component» C04 Autenticação e Sessão"; style="filled,rounded"; fillcolor="#FDECEC"; color="#C0392B"; penwidth=2;
    c04a [label="Verificador de\nCredenciais"];
    c04b [label="Emissor de\nTokens"];
    c04c [label="Registro de\nSessões"];
    c04d [label="Recuperação\nde Senha"];
    c04e [label="Publicador\nde Chaves"];
    c04a -> c04b; c04b -> c04c;
  }
  subgraph cluster_c07 {
    label="«component» C07 Orquestrador de Captura"; style="filled,rounded"; fillcolor="#FDECEC"; color="#C0392B"; penwidth=2;
    c07a [label="API de\nRegistros"];
    c07b [label="Máquina de Estados\ndo Registro"];
    c07c [label="Gestor de Créditos\nda Captura"];
    c07d [label="Supervisor\nde Sessões"];
    c07e [label="Caixa de\nSaída"];
    c07a -> c07b; c07b -> c07c; c07d -> c07b [label="interrupção"]; c07b -> c07e [label="mesma\ntransação"];
  }
  subgraph cluster_c08 {
    label="«component» C08 Ambiente de Navegação Controlada"; style="filled,rounded"; fillcolor="#FDECEC"; color="#C0392B"; penwidth=2;
    c08a [label="Pool de Navegadores\nIsolados"];
    c08b [label="Transmissor\nde Tela"];
    c08c [label="Repassador\nde Comandos"];
    c08d [label="Gravador de Vídeo\n(segmentos)"];
    c08e [label="Capturador\nde Tela"];
    c08a -> c08b; c08c -> c08a; c08a -> c08d; c08a -> c08e;
  }
  subgraph cluster_c09 {
    label="«component» C09 Selagem de Evidências"; style="filled,rounded"; fillcolor="#FDECEC"; color="#C0392B"; penwidth=2;
    c09a [label="Calculador\nde Hash"];
    c09b [label="Encadeador"];
    c09c [label="Montador de\nManifesto"];
    c09d [label="Assinador"];
    c09e [label="Carimbador\nde Tempo"];
    c09a -> c09b -> c09c -> c09d -> c09e;
  }
  subgraph cluster_c10 {
    label="«component» C10 Repositório de Evidências"; style="filled,rounded"; fillcolor="#FDECEC"; color="#C0392B"; penwidth=2;
    c10a [label="API Somente-\nInclusão"];
    c10b [label="Catálogo de\nEvidências"];
    c10c [label="Armazenamento\nImutável"];
    c10d [label="Verificador de\nIntegridade"];
    c10e [label="Controle de Acesso\npor Dono"];
    c10a -> c10b; c10a -> c10c; c10e -> c10d -> c10c;
  }

  // Interfaces oferecidas
  edge [arrowhead=none, color="#102A43"];
  i_sess -> c04a; i_chaves -> c04e; i_reg -> c07a; i_status -> c07b; i_nav -> c08a; i_selar -> c09a; i_arm -> c10a; i_ler -> c10e;

  // Dependências entre críticos (interfaces requeridas)
  edge [arrowhead=vee, style=dashed, color="#C0392B", fontcolor="#922B21"];
  c07c -> c05ext [label="reservar / confirmar /\nestornar (C05)"];
  c07b -> i_nav [label="usa INavegacao"];
  c08d -> i_selar [label="cada segmento"];
  c08e -> i_selar [label="cada imagem"];
  c07b -> i_selar [label="fecharManifesto"];
  c09c -> i_arm [label="arquivos e\nmanifesto"];
  c07e -> c14ext [label="pedidos de e-mail"];
  c04d -> c14ext [label="e-mail de\nrecuperação"];

  node [shape=box, style="rounded,dashed", fillcolor="#FFFFFF", color="#7F8C8D", fontcolor="#2C3E50", fontsize=9];
  c05ext [label="C05 Carteira\nde Créditos"];
  c14ext [label="C14 Notificações\npor E-mail"];
  sites  [label="«external»\nSites da internet"];
  tsa    [label="«external»\nAutoridade de\nCarimbo do Tempo"];
  cofre  [label="Cofre de chaves"];
  obj    [label="Armazenamento de objetos\ncom bloqueio de escrita"];
  edge [style=solid, color="#4A5A6A", fontcolor="#34495E"];
  c08a -> sites [label="navega"];
  c09e -> tsa; c09d -> cofre; c10c -> obj;
}
